{
  "type": "record",
  "name": "FeeCharge",
  "namespace": "com.idp.canonical",
  "doc": "Canonical product fee charge (Bronze `fee_charges`), associated with a product only; name and category live on the product. Adapted from TMF678 AppliedCustomerBillingRate.",
  "fields": [
    {
      "name": "tenant_id",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "product_id",
      "type": "string"
    },
    {
      "name": "charge_type",
      "type": {
        "type": "enum",
        "name": "ChargeType",
        "symbols": [
          "recurring",
          "one_time",
          "overage",
          "discount"
        ]
      }
    },
    {
      "name": "amount",
      "type": "double"
    },
    {
      "name": "currency",
      "type": "string"
    },
    {
      "name": "charged_at",
      "type": "string",
      "doc": "ISO-8601 timestamp, UTC (as Bronze stores it)"
    }
  ]
}
