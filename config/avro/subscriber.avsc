{
  "type": "record",
  "name": "Subscriber",
  "namespace": "com.idp",
  "doc": "Canonical subscriber dimension joining party/account/agreement/product. See plan 3.3/4.1.",
  "fields": [
    {"name": "tenant_id", "type": "string"},
    {"name": "service_id", "type": "string", "doc": "MSISDN"},
    {"name": "party_id", "type": "string"},
    {"name": "account_id", "type": "string"},
    {"name": "agreement_id", "type": "string"},
    {"name": "account_type", "type": "string"},
    {"name": "account_segment", "type": {"type": "enum", "name": "AccountSegment", "symbols": ["B2C", "B2B", "B2B2C"]}},
    {"name": "agreement_type", "type": {"type": "enum", "name": "AgreementType", "symbols": ["device", "subscription"]}},
    {"name": "business_line", "type": {"type": "enum", "name": "BusinessLine", "symbols": ["mobile", "broadband", "iptv", "fixed_line_telephony", "iot", "energy", "insurance"]}},
    {"name": "account_valid_from", "type": "long", "logicalType": "timestamp-millis"},
    {"name": "date_of_birth", "type": ["null", "string"], "default": null},
    {"name": "language", "type": ["null", "string"], "default": null},
    {"name": "is_company", "type": "boolean", "default": false},
    {"name": "consent_marketing", "type": "boolean", "default": false},
    {"name": "consent_analytics", "type": "boolean", "default": false},
    {"name": "num_products", "type": "int", "default": 0},
    {"name": "has_device_agreement", "type": "boolean", "default": false}
  ]
}
