{
  "type": "record",
  "name": "FactUsage",
  "namespace": "com.idp.silver",
  "doc": "Silver fact_usage: one row per voice or data event (documented contract, checked by tests). Partitioned by (tenant_id, day(started_at)). service_id, imei and other_party_number are tokenized; gross_amount = net_amount + tax_amount. created_at is kept as received (ISO-8601 text).",
  "fields": [
    {
      "name": "tenant_id",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "service_id",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Tokenized MSISDN."
    },
    {
      "name": "agreement_id",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "event_type",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "voice or data."
    },
    {
      "name": "started_at",
      "type": [
        "null",
        {
          "type": "long",
          "logicalType": "timestamp-micros"
        }
      ],
      "default": null,
      "doc": "UTC."
    },
    {
      "name": "created_at",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "ISO-8601 text, as received."
    },
    {
      "name": "net_amount",
      "type": [
        "null",
        "double"
      ],
      "default": null
    },
    {
      "name": "tax_amount",
      "type": [
        "null",
        "double"
      ],
      "default": null
    },
    {
      "name": "currency",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "qty",
      "type": [
        "null",
        "long"
      ],
      "default": null,
      "doc": "Seconds (voice) or bytes (data)."
    },
    {
      "name": "unit",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "is_roaming",
      "type": [
        "null",
        "boolean"
      ],
      "default": null
    },
    {
      "name": "network_tech",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "traffic_case",
      "type": [
        "null",
        "string"
      ],
      "default": null
    },
    {
      "name": "other_party_number",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Tokenized."
    },
    {
      "name": "imei",
      "type": [
        "null",
        "string"
      ],
      "default": null,
      "doc": "Tokenized."
    },
    {
      "name": "gross_amount",
      "type": [
        "null",
        "double"
      ],
      "default": null,
      "doc": "net_amount + tax_amount, rounded to 5 decimals."
    }
  ]
}
