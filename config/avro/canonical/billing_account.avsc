{
  "type": "record",
  "name": "BillingAccount",
  "namespace": "com.idp.canonical",
  "doc": "Canonical billing account (TMF666 BillingAccount): its paying party (relatedParty role payer) and whether that party is an organization.",
  "fields": [
    {
      "name": "tenant_id",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "account_type",
      "type": "string"
    },
    {
      "name": "lifecycle_status",
      "type": "string"
    },
    {
      "name": "valid_from",
      "type": "string",
      "doc": "ISO-8601 timestamp, UTC (as Bronze stores it)"
    },
    {
      "name": "payer_party_id",
      "type": "string",
      "doc": "The paying party (Individual or Organization)."
    },
    {
      "name": "is_company",
      "type": "boolean"
    }
  ]
}
