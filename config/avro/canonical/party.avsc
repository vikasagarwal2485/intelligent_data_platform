{
  "type": "record",
  "name": "Party",
  "namespace": "com.idp.canonical",
  "doc": "Canonical party (TMF632 Individual / Organization), as Silver's conform step produces it (REQ-BRZ-05). Person fields are null for organizations. The party's role and account belong to its customer.",
  "fields": [
    {
      "name": "tenant_id",
      "type": "string"
    },
    {
      "name": "id",
      "type": "string"
    },
    {
      "name": "first_name",
      "type": [
        "null",
        "string"
      ],
      "doc": "Null for organizations.",
      "default": null
    },
    {
      "name": "last_name",
      "type": [
        "null",
        "string"
      ],
      "doc": "Null for organizations.",
      "default": null
    },
    {
      "name": "date_of_birth",
      "type": [
        "null",
        "string"
      ],
      "doc": "ISO-8601 date; null for organizations.",
      "default": null
    },
    {
      "name": "language",
      "type": "string"
    },
    {
      "name": "phone",
      "type": "string"
    },
    {
      "name": "email",
      "type": "string"
    },
    {
      "name": "consent_marketing",
      "type": "boolean"
    },
    {
      "name": "consent_analytics",
      "type": "boolean"
    },
    {
      "name": "party_type",
      "type": {
        "type": "enum",
        "name": "PartyType",
        "symbols": [
          "individual",
          "organization"
        ]
      }
    },
    {
      "name": "organization_name",
      "type": [
        "null",
        "string"
      ],
      "doc": "Null for individuals.",
      "default": null
    },
    {
      "name": "organization_type",
      "type": [
        "null",
        "string"
      ],
      "doc": "Null for individuals.",
      "default": null
    }
  ]
}
