{
  "type": "record",
  "name": "UsageEvent",
  "namespace": "com.idp.tmf",
  "doc": "Canonical voice/data usage event (flattened from JSON:API). See plan 3.3.",
  "fields": [
    {"name": "tenant_id", "type": "string"},
    {"name": "id", "type": "string"},
    {"name": "service_id", "type": "string", "doc": "MSISDN"},
    {"name": "agreement_id", "type": ["null", "string"], "default": null},
    {"name": "event_type", "type": {"type": "enum", "name": "EventType", "symbols": ["voice", "data"]}},
    {"name": "started_at", "type": "long", "logicalType": "timestamp-millis"},
    {"name": "created_at", "type": "long", "logicalType": "timestamp-millis"},
    {"name": "gross_amount", "type": "double"},
    {"name": "tax_amount", "type": "double"},
    {"name": "currency", "type": "string", "default": "EUR"},
    {"name": "qty", "type": "long", "doc": "seconds for voice, bytes for data"},
    {"name": "unit", "type": "string"},
    {"name": "is_roaming", "type": "boolean", "default": false},
    {"name": "network_tech", "type": ["null", "string"], "default": null},
    {"name": "traffic_case", "type": ["null", "string"], "default": null, "doc": "originating|terminating"},
    {"name": "other_party_number", "type": ["null", "string"], "default": null},
    {"name": "imei", "type": ["null", "string"], "default": null}
  ]
}
